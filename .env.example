# ==============================================================================
# HabitPulse Environment Configuration (.env)
# ==============================================================================

# Supabase Project Configuration
# 1. Go to your Supabase Project Dashboard (https://supabase.com/dashboard)
# 2. Select project 'habitpluse' -> Project Settings -> API
# 3. Copy "Project URL" into VITE_SUPABASE_URL
# 4. Copy "Project API keys" -> "anon / public" into VITE_SUPABASE_ANON_KEY
# 5. Run the SQL schema from 'supabase_schema.sql' in Supabase SQL Editor
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Razorpay Payment Gateway (Test or Live Key ID)
# 1. Go to Razorpay Dashboard (https://dashboard.razorpay.com) -> Settings -> API Keys
# 2. Generate a Test key (rzp_test_...) or Live key (rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
